# Reference for every setting. In production these come from GitHub repo variables/secrets
# and are rendered to /etc/unraid-agent/agent.env on deploy; use this file for local runs.

# --- Required ---
UNRAIDCLAW_URL=https://192.168.1.10:9876/mcp
UNRAIDCLAW_API_KEY=
# SHA-256 of unraidclaw's self-signed cert. Pins it instead of disabling TLS verification.
#   python -c "import ssl,hashlib;print(hashlib.sha256(ssl.PEM_cert_to_DER_cert(ssl.get_server_certificate(('192.168.1.10',9876)))).hexdigest())"
UNRAIDCLAW_TLS_FINGERPRINT=

# --- Optional: pool disks straight from Unraid's GraphQL API ---
# unraidclaw 0.1.37 lists only array/parity disks, so pool-only servers show no disks.
# Use the WebGUI's HTTP port and a read-only Unraid API key (Settings > Management Access > API).
# WebGUI HTTP port: 80 by default (http://192.168.1.10/graphql); use the moved port if a reverse proxy owns 80/443.
UNRAID_GRAPHQL_URL=http://192.168.1.10/graphql
UNRAID_API_KEY=

# --- Behaviour ---
INTERVAL_MINUTES=10
# Apprise URLs, comma separated: https://github.com/caronc/apprise/wiki
NOTIFY_URLS=
RENOTIFY_HOURS=12

# --- Thresholds ---
DISK_TEMP_WARN=50
DISK_TEMP_CRIT=55
DISK_USAGE_WARN=90
# SMART (needs UNRAID_API_KEY): consecutive non-OK readings on a spinning disk before alerting
SMART_UNKNOWN_CYCLES=2
PARITY_MAX_AGE_DAYS=45
MEM_WARN_PERCENT=90
# 15-minute load average; 0 disables
LOAD_WARN=0
# Unraid notification importances to forward
NOTIFICATION_LEVELS=warning,alert
# Container / VM names to never report
DOCKER_IGNORE=
# Containers filling docker.img (needs UNRAID_API_KEY), in GB: writable layer, log, writable growth in 24 h
DOCKER_RW_WARN_GB=5
DOCKER_LOG_WARN_GB=1
DOCKER_RW_GROWTH_GB=2
# One-time notice per container with an image update
DOCKER_UPDATES=true
# Daily HH:MM-HH:MM windows (comma-separated, in the container's TZ) when containers stopping is
# expected, e.g. 05:00-05:10 for an appdata backup. A container still down after the window alerts then.
DOCKER_QUIET_WINDOWS=
# Regex over lm-sensors names to trust for CPU/board temperatures (empty disables). Default:
# k10temp|coretemp|zenpower|Tctl|Tdie|Tccd|Package id|Core \d+|CPUTIN|SYSTIN|MB Temp
# (TSI*_TEMP is excluded: on AMD boards it mirrors k10temp Tctl. Add it back if k10temp isn't loaded.)
# TEMP_SENSORS=
# Minutes a CPU/board sensor must stay over its limit before alerting, so load spikes
# from jobs don't page you (0 alerts at once)
TEMP_GRACE_MINUTES=10
# false skips VM checks entirely and hides VM tools from the LLM (set false if the server runs no VMs)
CHECK_VMS=true
VM_IGNORE=
SYSLOG_LINES=300
# SYSLOG_PATTERNS=regex1,regex2   (replaces the built-in disk/filesystem/MCE/OOM patterns)

# --- LLM diagnosis via OpenCode Go (optional; disabled when no key) ---
OPENCODE_API_KEY=
OPENCODE_MODEL=glm-5.2
# Free text about this server added to the diagnosis prompt (keep private details in the repo variable)
# SERVER_NOTES=ZFS pool of 8 disks, btrfs cache, no VMs
ESCALATE_COOLDOWN_HOURS=24
