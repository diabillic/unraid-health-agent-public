FROM python:3.13-slim-trixie

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN groupadd --system unraid-agent \
 && useradd --system --gid unraid-agent --home-dir /var/lib/unraid-agent --shell /usr/sbin/nologin unraid-agent \
 && install -d -o unraid-agent -g unraid-agent /var/lib/unraid-agent

WORKDIR /opt/unraid-agent/app
COPY requirements.txt ./
RUN pip install -r requirements.txt
COPY unraid_agent/ ./unraid_agent/
ARG REVISION=unknown
RUN echo "$REVISION" > REVISION

ENV STATE_PATH=/var/lib/unraid-agent/state.json
USER unraid-agent
VOLUME ["/var/lib/unraid-agent"]
EXPOSE 8765
CMD ["python", "-m", "unraid_agent"]
