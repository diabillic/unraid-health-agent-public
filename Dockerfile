# Don't edit by hand: it's regenerated whenever those files change. Change them instead.
#
# Build: docker build --pull --build-arg PATCHED_AT=$(date +%s) --build-arg REVISION=$(git rev-parse HEAD) -t unraid-agent .
# Run:   docker run -d --name unraid-agent --restart unless-stopped \
#     --env-file agent.env \
#     -v unraid-agent-data:/var/lib/unraid-agent \
#     -p 8765:8765 \
#     unraid-agent
#
# agent.env holds the settings in .env.example (the deploy workflow renders it from repo variables and secrets).

FROM python:3.13-slim-trixie

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
ENV TZ=America/New_York

ARG DEBIAN_FRONTEND=noninteractive
ARG PATCHED_AT=unknown
RUN echo "Patching the base OS ($PATCHED_AT)" \
 && apt-get update \
 && apt-get -y full-upgrade \
 && apt-get install -y --no-install-recommends ca-certificates tzdata \
 && ln -snf "/usr/share/zoneinfo/$TZ" /etc/localtime && echo "$TZ" > /etc/timezone \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN groupadd --system unraid-agent \
 && useradd --system --gid unraid-agent --home-dir /var/lib/unraid-agent --shell /usr/sbin/nologin unraid-agent \
 && install -d -o unraid-agent -g unraid-agent /var/lib/unraid-agent

WORKDIR /opt/unraid-agent/app
COPY requirements.txt ./
RUN pip install -r requirements.txt
COPY unraid_agent/ ./unraid_agent/
ARG REVISION=unknown
RUN echo "$REVISION" > REVISION

ENV STATE_PATH=/var/lib/unraid-agent/state.json
USER unraid-agent
VOLUME ["/var/lib/unraid-agent"]
EXPOSE 8765
HEALTHCHECK --interval=60s --timeout=15s --start-period=2m --retries=3 \
  CMD ["python", "-m", "unraid_agent.health"]
CMD ["python", "-m", "unraid_agent"]
